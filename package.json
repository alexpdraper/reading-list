{
  "name": "reading-list-extension",
  "version": "3.2",
  "description": "Reading List extension with manifest v3",
  "scripts": {
    "build": "rm -rf extension/scripts build && tsc && rollup -c",
    "format": "prettier --write src",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "test:update-snapshots": "npm run build && RL_UPDATE_SNAPSHOTS=1 node --test test/storage-load.test.mjs",
    "test:gen-fixtures": "node test/fixtures/generate.mjs"
  },
  "type": "module",
  "author": "",
  "dependencies": {
    "@lit-labs/motion": "^1.1.0",
    "fuse.js": "^7.5.0",
    "lit": "^3.2.1",
    "lz-string": "^1.5.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/chrome": "^0.0.278",
    "@types/lz-string": "^1.3.34",
    "@web/rollup-plugin-copy": "^0.5.1",
    "@web/rollup-plugin-html": "^2.3.0",
    "prettier": "^3.3.3",
    "rollup": "^2.79.2",
    "rollup-plugin-minify-html-literals": "^1.2.6",
    "rollup-plugin-summary": "^2.0.1",
    "typescript": "^5.6.3"
  }
}
